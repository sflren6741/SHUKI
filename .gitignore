!scripts/dashboard_sfx.py
!scripts/dashboard_theme.py
!scripts/dashboard_tutorial.py
!scripts/test_dashboard_tutorial.py
!scripts/dashboard_ui.py
!scripts/dashboard_voice_context.py
!scripts/dashboard_voice.js
!scripts/decisions.py
!scripts/i18n_scan.py
!scripts/model_registry.json
!scripts/prompt_layers.py
!scripts/test_prompt_layers.py
!scripts/model_registry.py
!scripts/model_executor.py
!scripts/news_fetch.py
!scripts/news_store.py
!scripts/profile.example.json
!scripts/shuki_db.py
!scripts/shuki_i18n.py
